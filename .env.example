# ---- Rep & Sip environment ----
# Copy to `.env` and fill in. Never commit the real `.env`.

# Demo mode: set to 1 to run the whole app on realistic local data with NO
# backend or API keys (great for testing on a phone via Expo Go). Leave blank
# (or 0) for the real Supabase/Google-backed app.
EXPO_PUBLIC_DEMO_MODE=

# Supabase (Project Settings -> API). These are PUBLIC client keys (anon),
# safe to ship in the app. RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Places API key — used by the app at runtime for hotel search/details.
# Restrict it to the Places API + your app bundle ids in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR-PLACES-KEY

# Google Maps native SDK key — injected into native iOS/Android config by
# app.config.ts (NOT EXPO_PUBLIC_ because it's a build-time native value).
# Can be the same key as above if it's enabled for Maps SDK for Android/iOS.
GOOGLE_MAPS_API_KEY=YOUR-MAPS-KEY

# OAuth client ids for Google one-tap sign-in (from Google Cloud OAuth consent).
# iOS/Android use native client ids; Expo Go / web use the web client id.
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=

# ---- Affiliate booking (Check Prices) ----
# Your affiliate id is what earns commission — set it before going live.
EXPO_PUBLIC_AFFILIATE_PROVIDER=booking         # booking | stay22
EXPO_PUBLIC_AFFILIATE_ID=                       # your Booking.com aid / Stay22 aid
# Optional: full URL template override with {aid}{name}{city}{lat}{lng}{checkin}{checkout}{guests}
EXPO_PUBLIC_AFFILIATE_TEMPLATE=

# Optional: an endpoint that returns live best prices for a hotel + dates,
# as { nightlyFrom, total, currency }. Without it, a demo estimate is shown.
EXPO_PUBLIC_HOTEL_PRICE_ENDPOINT=
