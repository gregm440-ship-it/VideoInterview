# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Database (Neon Postgres) ----
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ---- Auth (Clerk — recruiter / client accounts) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Candidate token JWT (jose) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CANDIDATE_TOKEN_SECRET=
CANDIDATE_TOKEN_TTL_DAYS=7

# ---- Anthropic (Claude API) ----
# Defaults: opus for analysis, haiku for question generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ANALYSIS=claude-opus-4-7
ANTHROPIC_MODEL_QUESTIONS=claude-haiku-4-5
ANTHROPIC_ORG_TOKEN_BUDGET_MONTHLY=2000000

# ---- Deepgram (transcription) ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---- Cloudflare R2 (video storage, S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=outsorcy-interviews
R2_PUBLIC_BASE_URL=

# ---- Resend (transactional email) ----
RESEND_API_KEY=
EMAIL_FROM="Outsorcy <hello@outsorcy.com>"

# ---- Upstash Redis (BullMQ queue) ----
REDIS_URL=
